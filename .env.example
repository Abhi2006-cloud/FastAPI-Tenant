# Application
APP_NAME=AI Workspace SaaS Backend
DEBUG=false

# Backend API URL (for frontend)
API_BASE_URL=http://localhost:8000

# Database (async driver for the app)
# Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_workspace
# Neon PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname?ssl=require

# Sync URL for Alembic migrations (optional; derived from DATABASE_URL if unset)
# ALEMBIC_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Invitations
INVITATION_EXPIRE_HOURS=72

# Redis (Upstash or self-hosted)
# Upstash Redis URL format: rediss://default:password@host:port
# Local Redis: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Alternative Redis configuration (if REDIS_URL not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Background jobs (RQ)
# JOB_SYNC_MODE=true runs jobs inline (used by tests; leave false in production)
JOB_SYNC_MODE=false
RQ_JOB_TIMEOUT=300
RQ_RETRY_MAX=3
RQ_RETRY_INTERVALS=10,30,60
RQ_RESULT_TTL=86400
RQ_FAILURE_TTL=604800

# Meilisearch
MEILISEARCH_URL=<MEILISEARCH_CLOUD_URL>
MEILISEARCH_API_KEY=<MEILISEARCH_ADMIN_API_KEY>
MEILISEARCH_INDEX_PREFIX=ai_workspace

