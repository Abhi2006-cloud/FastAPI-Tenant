# ==============================================================================
# AI Workspace SaaS - Production Environment Variable Template (.env.example)
# ==============================================================================
# WARNING: NEVER commit actual production credentials or secrets to Git.
# Use this file as a reference when configuring environment variables in Render.
# ==============================================================================

# Application Setup
APP_NAME=AI Workspace SaaS Backend
ENVIRONMENT=production
DEBUG=false

# Database Configuration (Neon PostgreSQL)
# Async database URL used by FastAPI application runtime (asyncpg)
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<NEON_HOST>/<DBNAME>?ssl=require
# Sync database URL used by Alembic migrations (psycopg2)
ALEMBIC_DATABASE_URL=postgresql://<USER>:<PASSWORD>@<NEON_HOST>/<DBNAME>?sslmode=require

# Security & Authentication (JWT)
# Generate a secure 64-character hex secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<PRODUCTION_RANDOM_SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Session Management (v2.4.0)
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_ACTIVE_SESSIONS=20
ALLOW_MULTIPLE_SESSIONS=true
ROTATE_REFRESH_TOKENS=true
REVOKE_ON_REFRESH_REPLAY=true
SESSION_CLEANUP_INTERVAL_HOURS=24

# Redis (Upstash Managed TLS Redis)
# Connection format: rediss://default:<PASSWORD>@<UPSTASH_HOST>:<PORT>
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_HOST>:<UPSTASH_PORT>

# Background Jobs (RQ Worker)
JOB_SYNC_MODE=false
RQ_JOB_TIMEOUT=300
RQ_RETRY_MAX=3
RQ_RETRY_INTERVALS=10,30,60
RQ_RESULT_TTL=86400
RQ_FAILURE_TTL=604800

# Search Engine (Meilisearch Cloud)
# Note: Degraded mode supported if Meilisearch trial expires or is offline
MEILISEARCH_URL=https://<MEILISEARCH_CLOUD_HOST>
MEILISEARCH_API_KEY=<MEILISEARCH_ADMIN_API_KEY>
MEILISEARCH_INDEX_PREFIX=ai_workspace

# Email Infrastructure (Resend)
EMAIL_MODE=production
EMAIL_PROVIDER=resend
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM_NAME=AI Workspace
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com
EMAIL_QUEUE_NAME=email
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_SECONDS=30
EMAIL_RATE_LIMIT_PER_HOUR=20
EXPOSE_INVITATION_TOKENS=false

# CORS & Domain Setup
FRONTEND_URL=https://<YOUR_REACT_APP>.onrender.com
ALLOWED_ORIGINS=https://<YOUR_REACT_APP>.onrender.com

# File Management & Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Optional S3 Cloud Storage (Cloudflare R2 / AWS S3)
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<S3_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<S3_SECRET_ACCESS_KEY>
# S3_BUCKET_NAME=<S3_BUCKET_NAME>
# S3_REGION=auto

# Invitations
INVITATION_EXPIRE_HOURS=72
