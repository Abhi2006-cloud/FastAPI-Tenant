# Application
APP_NAME=AI Workspace SaaS Backend
DEBUG=false

# Database (async driver for the app)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_workspace

# Sync URL for Alembic migrations (optional; derived from DATABASE_URL if unset)
# ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_workspace

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Invitations
INVITATION_EXPIRE_HOURS=72
