# ==============================================================================
# AI Workspace SaaS - Zero-Cost Production Environment Variable Template (.env.example)
# ==============================================================================
# WARNING: NEVER commit actual production credentials or secrets to Git.
# Use this file as a reference when configuring environment variables in Render.
# ==============================================================================

# Application Setup
APP_NAME=AI Workspace SaaS Backend
ENVIRONMENT=production
DEBUG=false
WEB_CONCURRENCY=1

# Database Configuration (Neon Serverless PostgreSQL)
# DATABASE_URL uses the POOLED connection host (contains "-pooler", PgBouncer):
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<NEON_PROJECT_ID>-pooler.<REGION>.aws.neon.tech/<DBNAME>?ssl=require
# ALEMBIC_DATABASE_URL uses the DIRECT (non-pooler) host for migrations (DDL/session level):
ALEMBIC_DATABASE_URL=postgresql://<USER>:<PASSWORD>@<NEON_PROJECT_ID>.<REGION>.aws.neon.tech/<DBNAME>?sslmode=require

# Database Connection Pool (PgBouncer tuning)
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_CONNECT_TIMEOUT=30.0

# Security & Authentication (JWT)
# Generate a secure 64-character hex secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<PRODUCTION_RANDOM_SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALGORITHM=HS256

# Session Management (v2.4.0)
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_ACTIVE_SESSIONS=20
ALLOW_MULTIPLE_SESSIONS=true
ROTATE_REFRESH_TOKENS=true
REVOKE_ON_REFRESH_REPLAY=true
SESSION_CLEANUP_INTERVAL_HOURS=24

# Redis (Upstash Serverless TLS Redis)
# IMPORTANT: Use the Upstash TCP/TLS connection URL with rediss:// scheme.
# Do NOT use the Upstash REST URL or REST tokens!
# Format: rediss://default:<PASSWORD>@<HOST>.upstash.io:6379
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_HOST>.upstash.io:6379

# Background Jobs (Embedded RQ Worker)
# When EMBEDDED_WORKER=true, a single RQ SimpleWorker daemon thread runs inside the FastAPI process.
EMBEDDED_WORKER=true
EMBEDDED_WORKER_QUEUES=high,default,low,email
JOB_SYNC_MODE=false
RQ_JOB_TIMEOUT=300
RQ_RETRY_MAX=3
RQ_RETRY_INTERVALS=10,30,60
RQ_RESULT_TTL=86400
RQ_FAILURE_TTL=604800

# Search Engine (Meilisearch)
# Disabled on zero-cost free tier (subscription ended; prevents doomed retry loops)
SEARCH_ENABLED=false
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=
MEILISEARCH_INDEX_PREFIX=ai_workspace

# Email Infrastructure (Console / Zero-cost)
# Uses console delivery mode so invitations/links log safely without paid provider
EMAIL_MODE=development
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM_NAME=AI Workspace
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_QUEUE_NAME=email
EMAIL_MAX_RETRIES=5
EMAIL_RATE_LIMIT_PER_HOUR=20
EXPOSE_INVITATION_TOKENS=false

# File Management & Storage
# Use 'postgres' backend on Render free tier (ephemeral disk wiped on restart/spin-down)
# Files are stored as BYTEA in file_blobs table.
STORAGE_BACKEND=postgres
MAX_UPLOAD_SIZE_MB=2
UPLOAD_DIR=uploads

# CORS & Domain Setup (Vercel Frontend)
FRONTEND_URL=https://<YOUR_APP>.vercel.app
ALLOWED_ORIGINS=https://<YOUR_APP>.vercel.app

# Invitations
INVITATION_EXPIRE_HOURS=72

# Platform Administration & Demo Defaults
DEMO_ENABLED=true
PLATFORM_ADMIN_EMAILS=admin@example.com
